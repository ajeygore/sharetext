# --- Server ---
PORT=3000
# Empty (or unset) means the app owns the domain root, which is the normal
# case. Set it only to mount under a path on a shared domain, e.g. /sharetext.
# It is baked into the frontend bundle, so rebuild after changing it.
BASE_PATH=
# Public origin the app is reachable at. Used to build the OAuth redirect URI.
PUBLIC_ORIGIN=http://localhost:3000

# --- Session ---
# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Google OAuth ---
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI must be exactly: <PUBLIC_ORIGIN><BASE_PATH>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
