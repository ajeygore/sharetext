# --- Server ---
PORT=3000
# Empty (or unset) means the app owns the domain root, which is the normal
# case. Set it only to mount under a path on a shared domain, e.g. /sharetext.
BASE_PATH=
PUBLIC_ORIGIN=http://localhost:3000
# Set to "production" to enforce SESSION_SECRET and disable the dev login.
APP_ENV=

# --- Session ---
# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Google OAuth ---
# Authorized redirect URI must be exactly: <PUBLIC_ORIGIN><BASE_PATH>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
